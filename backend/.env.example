# Hyper Alpha Arena - Environment Configuration

# =================================================================
# Hyperliquid Trading Configuration
# =================================================================

# Encryption key for private key storage (REQUIRED for Hyperliquid trading)
# Generate with: python utils/encryption.py
# Keep this secret! If lost, you cannot decrypt stored private keys.
HYPERLIQUID_ENCRYPTION_KEY=your-encryption-key-here

# Hyperliquid environment defaults
# These can be overridden per account in the database
HYPERLIQUID_MAX_LEVERAGE=10
HYPERLIQUID_MIN_ORDER_VALUE=10.0
HYPERLIQUID_MAX_POSITION_VALUE_PER_ORDER=1000.0

# =================================================================
# API Configuration (existing)
# =================================================================

# API Key for protecting dangerous write operations (system control, trading, config).
# If not set, all API routes are accessible without authentication.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# BACKEND_API_KEY=your-api-key-here

# Add your other environment variables below...

# =================================================================
# QAA v3.0 Architecture Configuration
# =================================================================

# QAA mode: legacy (default) | qaa (multi-agent dispatch)
# QAA_MODE=legacy

# QAA v3.0 TickOrchestrator (only when QAA_MODE=qaa)
# false=legacy EventBus dispatch | true=v3.0 TickOrchestrator + TradingPlugin
# QAA_V3_ENABLED=false

# QAA enabled domains (comma-separated)
# QAA_ENABLED_DOMAINS=trading

# QAA tick budget in milliseconds
# QAA_TICK_BUDGET_MS=120000

# QAA 3.1 semantic memory: persist unified learning outcomes into RAG memory
# QAA_SEMANTIC_MEMORY_ENABLED=true
# QAA_KNOWLEDGE_DIR=./data/qaa_knowledge

# --- 整改#16 混合RAG升级（默认保持 hash+jsonl 旧行为，opt-in 神经+Chroma）---
# 嵌入后端：hash（默认，零依赖）| neural（sentence-transformers/BGE，加载失败自动降级 hash）
# QAA_EMBEDDING_BACKEND=neural
# QAA_EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
# 知识库后端：in_memory（默认）| jsonl（bridge 默认）| chroma（ChromaDB HNSW，失败自动回退）
# QAA_KNOWLEDGE_BACKEND=chroma
# QAA_CHROMA_DIR=./data/qaa_chromadb
# --- 整改#9 事件溯源 Phase 2（双写+内存投影+C7对拍；读路径默认仍走 DB）---
# EVENT_SOURCING_ENABLED=false
# EVENT_SOURCING_LOG_PATH=./data/event_log.jsonl
# EVENT_SOURCING_PHASE2_RECONCILE=true   # 写后/读前 DB vs 投影对拍，不一致 fail-open 回退 DB
# EVENT_SOURCING_PHASE2_READ=false       # true=对拍一致时 get_positions 走投影
# EVENT_SOURCING_PHASE3=false            # true=投影默认读路径 + 启动 DB→事件引导

# --- 整改#15 DSPy 认知层编译器（默认关→no-op 返回基础指令；dspy 缺失时用 metric 驱动随机搜索）---
# DSPY_COMPILE_ENABLED=false
# DSPY_MAX_TRIALS=50                    # 指令×few-shot 组合搜索的 trial 数（喂 #21 PBO）
# DSPY_RECOMPILE_INTERVAL_DAYS=7        # 实盘 metric 退化时的再编译周期

# --- 整改#16b 交叉编码器重排序（默认关；开后过采样召回→精排 top_k，修中文术语语义匹配）---
# QAA_RERANKER_ENABLED=false
# QAA_RERANKER_BACKEND=cross_encoder   # cross_encoder（sentence-transformers，失败降级）| lexical（零依赖词法）
# QAA_RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# --- 整改#1 Walk-Forward 方法论（默认等价旧行为；env 未设时 purge/embargo=0、optimizer=grid）---
# WFO_PURGE_DAYS=5           # train/test 间 purge 间隙（防泄漏，推荐 5）
# WFO_EMBARGO_DAYS=3         # test 后 embargo 间隙（防标签前瞻，推荐 3）
# WFO_OPTIMIZER=optuna       # grid（默认）| optuna（TPE，需装 optuna，缺失自动回退）| cma_es（暂回退 grid）
# WFO_N_OPTUNA_TRIALS=100
# WFO_LOSS_FUNCTION=sharpe   # sharpe|sortino|calmar|max_drawdown|profit_factor|sharpe_dd|ulcer
# WFO_RUN_DSR=true           # DSR/PSR/MinBTL 诊断（便宜，默认开）
# WFO_RUN_CSCV=false         # CSCV/PBO 过拟合概率（较贵，默认关）
# WFO_CSCV_N_BLOCKS=16

# --- 整改#10 ML 训练管线（FreqAI 式滚动重训；后端缺失自动降级 linear）---
# ML_MODEL_TYPE=lightgbm     # linear（兜底）| lightgbm（默认）| catboost | pytorch_gru
# ML_TRAIN_PERIOD_DAYS=90    # 训练回看窗
# ML_PREDICT_PERIOD_DAYS=7   # 预测窗/重训步长
# ML_PURGE_DAYS=5            # train/predict 间 purge gap
# ML_EMBARGO_DAYS=3          # predict 后 embargo
# ML_LIVE_RETRAIN_HOURS=12   # 实盘重训节奏
# ML_PIPELINE_ENABLED=true   # #10 持续重训主路径（learning_loop 维护周期触发）
# ML_ACTIVATION_DEBOUNCE_SEC=600
# ML_MODEL_DIR=./data/ml_models

# --- 整改#4 学习型因子加权（默认 regime，与手工权重表并列；learned/hybrid 为 opt-in 影子）---
# FACTOR_WEIGHTING_MODE=hybrid   # regime（旧）| learned | hybrid（激进 rollout 默认 hybrid）
# LEARNED_WEIGHTING_ENABLED=true
# HYBRID_LEARNED_BLEND=0.45      # hybrid 模式下 learned 信号融合比例
# LEARNED_MODEL_TYPE=lightgbm     # lightgbm | pytorch_gru | linear | ic_weighted
# LEARNED_LABEL_HORIZON=5         # 前瞻收益窗口（根）
# LEARNED_RETRAIN_HOURS=24        # 重训频率
# LEARNED_TRAIN_LOOKBACK_DAYS=90
# LEARNED_MIN_IC=0.015            # 低于此 IC 的因子不参与训练
# LEARNED_PURGE_BARS=5

# --- 整改#11 对抗辩论层 + 市场数据验证（默认关；opt-in，无 LLM 时规则降级）---
# ADVERSARIAL_DEBATE_ENABLED=true    # 牛/熊+风险角色对抗辩论（激进 rollout 默认开）
# DEBATE_MAX_ROUNDS=3
# MARKET_DATA_VERIFIER_ENABLED=true  # LLM 输出数值的确定性校验（防幻觉，自动纠正）

# --- 整改#5 引擎层硬风控（激进 rollout 默认开）---
# RISK_ENGINE_ENABLED=true
# RISK_MAX_SUBMITS_PER_SEC=10
# RISK_ALLOW_OVERFILLS=false

# --- 整改#12 Deribit 期权数据源（免费公开 API，无需 key；激进 rollout 默认开）---
# DERIBIT_OPTIONS_ENABLED=true   # compute_all_factors / factor_bridge 自动 inject_into_klines
# 说明：Glassnode/Nansen/CoinGlass 等付费源本轮按"只做免费源"口径跳过，日后有 key 再补

# --- 整改#13 LLM 供应商工厂 + 语义缓存（默认关；opt-in，不改现有 LLM 调用路径）---
# LLM_SEMANTIC_CACHE_ENABLED=false   # 开启后 get_llm() 返回带语义缓存的客户端
# LLM_CACHE_TTL_SECONDS=60
# LLM_CACHE_THRESHOLD=0.95           # cosine≥此值且未过期才命中（越高越保守）
# LLM_TASK_ROUTINE_TICK=local_vllm   # 覆盖任务→供应商路由（deepseek/openai/anthropic/local_vllm）
# LLM_TASK_DEEP_ANALYSIS=deepseek
# LLM_TASK_AMBIGUOUS_EVENT=anthropic

# --- 整改#19 MAP-Elites 多样性冠军库（默认关；开后与单 champion recovery 并行，按 regime 选 elite）---
# MAP_ELITES_ENABLED=false
# MAP_ELITES_MODE=single             # single=每格单精英 | mome=每格 Pareto 前沿（多目标）

# --- 整改#20 CMA-ES 连续参数精调（默认 naive_minus_10 保持旧行为；optuna 缺失自动回退随机搜索）---
# QAA_OPTIMIZER=naive_minus_10       # cmaes=启用 CMA-ES 协方差自适应精调
# CMAES_TRIALS=100

# --- 整改#21 PBO-aware 血缘账本（默认关→should_reject_promotion 恒放行；复用整改#1 overfitting_metrics）---
# PBO_AUDIT_ENABLED=false
# PBO_REJECT_THRESHOLD=0.5           # CSCV-PBO 超过此值判为过拟合，拒绝该代晋升

# --- 整改#17 EWC + replay 防遗忘（默认关→penalty=0、mix_batch 返回原 batch；纯 numpy，模型无关）---
# EWC_ENABLED=false
# EWC_LAMBDA=400                     # EWC 惩罚强度（论文默认 400）
# REPLAY_RATIO=0.3                   # 新 batch 掺入旧 regime 分层样本的比例

# --- 整改#18 DDG-DA 主动分布预测（默认关→reweight 返回全 1 权重；simplified 零依赖可立即上线）---
# DDGDA_ENABLED=false
# DDGDA_MODE=simplified             # simplified=漂移驱动时间衰减 | full=元模型（torch 可选）
# DDGDA_MAX_HALFLIFE=500            # 漂移弱时的样本半衰期（接近均匀）
# DDGDA_MIN_HALFLIFE=30             # 漂移强时的样本半衰期（重近期）

# --- 晋升门 shadow→canary→full（learning_loop 维护周期扫描，默认开）---
# PROMOTION_GATE_ENABLED=true
# PROMOTION_SCAN_DEBOUNCE_SEC=1800   # 扫描去抖（秒）
# PROMOTION_MIN_TRADES=20
# PROMOTION_MIN_WIN_RATE=0.48
# PROMOTION_MAX_DRAWDOWN=0.15
# PROMOTION_MIN_DSR=0.55
# PROMOTION_CANARY_MIN_PNL_DELTA=0.005

# =================================================================
# AI Agent 五层流水线 (2026-06 重构)
# =================================================================

# DualAgent: off | shadow | advisory | primary
# 模拟盘默认 primary；实盘可改 off 仅用 MasterController
# DUAL_AGENT_MODE=primary

# short/scalp/intraday 硬门槛（绩效归因：短线 tier 累计亏损）
# SHORT_TIER_CONFIDENCE_EXTRA=8
# SHORT_TIER_SAME_DIR_COOLDOWN_S=1800
# SHORT_TIER_DISABLED_NATURES=scalp

# =================================================================
# Redis / 多 worker WS 广播 (Phase 5 Task 5.2)
# =================================================================
# 留空(默认)=单 worker 本地直发,dev 无需 Redis。
# 生产多 worker(gunicorn -w N)时设置,用于跨 worker 广播 WebSocket 消息。
# REDIS_URL=redis://127.0.0.1:6379/0
