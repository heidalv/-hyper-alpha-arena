{
  "name": "frontend-next",
  "version": "0.2.7",
  "description": "Heidalv Alpha Arena desktop client",
  "author": "Heidalv Alpha Arena",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "dev": "next dev -p 5273",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "e2e": "playwright test",
    "electron:dev": "wait-on http://127.0.0.1:5273/login && electron .",
    "electron:dev:full": "concurrently \"npm run dev\" \"wait-on http://127.0.0.1:5273/login && electron .\"",
    "electron:build": "next build && cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder",
    "electron:pack": "cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --dir",
    "electron:build:prod": "cross-env NEXT_PUBLIC_API_URL=https://api.yourdomain.com NEXT_PUBLIC_WS_URL=wss://api.yourdomain.com/ws npm run electron:build",
    "electron:publish": "powershell -NoProfile -ExecutionPolicy Bypass -File ../scripts/publish-desktop.ps1",
    "electron:start": "electron ."
  },
  "dependencies": {
    "electron-log": "^5.4.4",
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "@base-ui/react": "^1.6.0",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@tanstack/react-query": "^5.101.2",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "concurrently": "^9",
    "cross-env": "^10.1.0",
    "electron": "^33",
    "electron-builder": "^25",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "lightweight-charts": "^5.0.9",
    "lucide-react": "^0.536.0",
    "next": "16.2.10",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "recharts": "^3.9.2",
    "shadcn": "^4.13.0",
    "tailwind-merge": "^3.3.1",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5",
    "wait-on": "^8",
    "zustand": "^5.0.14"
  }
}
