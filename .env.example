# 币安API代理配置示例
# 如果你使用VPN软件访问币安API，请配置代理地址

# 常见VPN软件的代理端口：
# - Clash: 7890
# - V2rayN: 10809
# - Shadowsocks: 1080

# 配置示例（取消注释并修改端口）：
# BINANCE_HTTP_PROXY=http://host.docker.internal:7890
# BINANCE_HTTPS_PROXY=http://host.docker.internal:7890

# 如果不需要代理，保持注释或留空即可

# ═══ 免费数据源 API Keys（可选） ═══
# 以下均为免费注册即可使用

# CryptoPanic 新闻聚合 (注册: https://cryptopanic.com/developers/api/)
# CRYPTOPANIC_API_KEY=

# Coinalyze 免费合约数据 (免费注册: https://coinalyze.net/account/api-key/)
# 提供清算数据、多空比、OI等
# COINALYZE_API_KEY=

# ═══ 无需Key的免费数据源（自动使用） ═══
# Hyperliquid 原生 API — 资金费率/OI/标记价格
# Binance 公开 API — OI历史/多空比/大户多空比
# blockchain.info + mempool.space — 鲸鱼链上大额交易
# Alternative.me — 恐惧贪婪指数

# ═══════════════════════════════════════════════════════════
# AI 自动学习 & 自动进化 闭环 Feature Flags（P2-3）
# 所有 flag 默认保守，开启前请先在影子模式下观察指标至少一周。
# ═══════════════════════════════════════════════════════════

# 学习闭环总开关：关闭后 LearningLoopService 的三个 tick 全部跳过
# （等价于禁用 AI 自动学习/自动进化，回退到纯规则交易）
LEARNING_LOOP_ENABLED=true

# DRL 自动重训：system_coordinator.trigger_drl_retrain 被 LearningLoop 消费时是否
# 真正启动 shadow training；false 时仅记日志不训练（默认 false，41天数据不足以训练）。
DRL_RETRAIN_AUTO=false

# 组合风险硬阻塞：true=超阈值直接 passed=False 拦单；false=仅夹紧 position_pct（默认）
PORTFOLIO_RISK_HARD_BLOCK=false

# —— 学习中心统一后端开关（L5 集中化，对应 BackendRegistry 各后端 enabled）——
# 默认全部关闭，按需开启。dashboard /api/learning/dashboard/feature-flags 可运行时查看。
# AI_FACTOR_STRATEGY_JOINT_ENABLED=false   # 因子-策略贝叶斯联合更新后端
# AI_CONCEPT_DRIFT_DETECTION_ENABLED=false # 概念漂移检测后端（concept_drift_detector）
# AI_CAUSAL_DISCOVERY_ENABLED=false        # 因果发现后端（causal_discovery_engine）
# NSGA2_ENABLED=true                       # NSGA-II 多目标进化（evolution_scheduler）

# —— 以下是已有但容易遗漏的 AI 整合开关，列在这里方便集中管理 ——
# ENABLE_COORDINATOR=true              # 系统协调器总开关
# ENABLE_DRL_INTEGRATION=false         # DRL 建议注入主循环
# DRL_SHADOW_MODE=true                 # DRL 影子模式（只记录不执行）
# ENABLE_KELLY_POSITION=true           # Kelly 作为仓位上限
# ENABLE_PORTFOLIO_RISK=false          # 组合级风险聚合
# ENABLE_EVOLUTION_FEEDBACK=false      # 进化结果反哺实盘
# PORTFOLIO_MAX_RISK=0.30              # 组合总风险上限
# PORTFOLIO_MAX_CORRELATION_RISK=0.75  # 组合相关性风险上限
# PORTFOLIO_MAX_SINGLE_POSITION=0.25   # 单币种最大仓位占比

# —— 策略护栏（P2-9）：低胜率策略自动软冷冻 ——
# 评估窗口内若某 strategy 达到最小样本数且胜率低于阈值，则在风控入口
# 返回 passed=False（不影响其它策略）；冷却期结束自动恢复。
# STRATEGY_GUARD_WINDOW_HOURS=48
# STRATEGY_GUARD_MIN_SAMPLES=10
# STRATEGY_GUARD_MIN_WINRATE=0.15
# STRATEGY_GUARD_COOLDOWN_HOURS=6

# ═══════════════════════════════════════════════════════════
# OpenCode 智能分析层
# DeepSeek 模型 API 配置在 opencode.json（非后端直连）
# Key 写在 DEEPSEEK_API_KEY，由 Sidecar 启动脚本注入
# 首次配置: .\scripts\setup_opencode.ps1
# 仅启动 Sidecar: .\scripts\start_opencode_sidecar.ps1
# 校验: backend\.venv\Scripts\python.exe scripts\verify_opencode_config.py
# ═══════════════════════════════════════════════════════════
# OPENCODE_ENABLED=true

# ═══ 绑定车道 / 熔断（运维台可见；默认安全干跑）═══
# PAIR_BINDING_LANE_ENABLED=false
# PAIR_BINDING_LANE_INTERVAL_SEC=300
# SCALP_CIRCUIT_BREAKER_ENABLED=false
# SCALP_CIRCUIT_BREAKER_INTERVAL_SEC=600
# OPENCODE_SERVER_URL=http://127.0.0.1:4096
# OPENCODE_AGENT_PLAN=plan
# OPENCODE_MODEL=deepseek/deepseek-v4-flash
# OPENCODE_SMALL_MODEL=deepseek/deepseek-v4-flash
# OPENCODE_BRIDGE_TRANSPORT=http
# OPENCODE_REQUEST_TIMEOUT_S=180
# OPENCODE_AUTO_APPLY_MINOR=true
# OPENCODE_VALIDATION_HOURS=24
# OPENCODE_SHADOW_ENABLED=false
# OPENCODE_SHADOW_PORT=8001
# DEEPSEEK_API_KEY=sk-your-key-here
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DeepSeek V4 思考模式分层（默认 auto：短线关思考 / 决策 high / 重任务 max）
# DEEPSEEK_THINKING_MODE=auto
# DEEPSEEK_REASONING_EFFORT=auto
# DEEPSEEK_THINKING_MAX_TOKENS_FLOOR=16000
# OPENCODE_MAJOR_CREATE_PROPOSALS=true
# OPENCODE_MAJOR_AUTO_APPLY=false
# OPENCODE_MAJOR_PACE_DOWNSHIFT_STEPS=1
# OPENCODE_MAJOR_PACE_FLOOR=balanced

# ═══ 绑定车道 / 熔断（运维台可见；默认安全干跑，禁止静默开仓）═══
# PAIR_BINDING_LANE_ENABLED=false
# PAIR_BINDING_LANE_INTERVAL_SEC=300
# SCALP_CIRCUIT_BREAKER_ENABLED=false
# SCALP_CIRCUIT_BREAKER_INTERVAL_SEC=600

# ═══ 中线/长线 Agent 链路（默认已开启，一般无需改） ═══
# ORCH_MID_INDEPENDENT_TRIGGER=true
# MIDLONG_PERSISTENCE_TICKS=2
# MIDLONG_QUANT_BRIEF_ENABLED=true
# MIDLONG_AGENT_SL_TO_EXECUTE=true
# MIDLONG_ORCH_SNAPSHOT_V2=true
# UNIFIED_DATA_POOL_KLINE_DERIVATIVES_PREFETCH=true
# AGENT_FACT_GUARD_PAPER_ENFORCE=true

# 2026-08-19 三周期报告观测体系（日报/周报 LLM 分析，非交易路径，失败静默）
LLM_PERIOD_DAILY_REVIEW=0
LLM_LONG_TERM_REVIEW=0
